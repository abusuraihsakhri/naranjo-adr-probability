{
  "openapi": "3.1.0",
  "info": {
    "title": "Naranjo ADR Probability API",
    "description": "Ten-question Naranjo causality scoring plus separate demonstration operations endpoints.",
    "version": "1.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/api/naranjo": {
      "post": {
        "summary": "Score an explicitly completed Naranjo questionnaire",
        "description": "Responses q1 through q10 must each be yes, no, or unknown. Missing or invalid values return HTTP 422.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "responses"
                ],
                "properties": {
                  "responses": {
                    "type": "object",
                    "description": "Mapping containing q1 through q10 as yes, no or unknown",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Causality score and itemized contributions"
          },
          "422": {
            "description": "Missing or invalid answers"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Text-format operational counters",
        "responses": {
          "200": {
            "description": "Prometheus metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate demonstration operations task",
        "description": "This endpoint is not the Naranjo causality questionnaire.",
        "responses": {
          "200": {
            "description": "Operations dossier"
          },
          "422": {
            "description": "Invalid task"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Query demonstration mock supervisory interface",
        "responses": {
          "200": {
            "description": "Demonstration reply"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory audit metadata and integrity result",
        "responses": {
          "200": {
            "description": "Audit records"
          }
        }
      }
    }
  }
}
